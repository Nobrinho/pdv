{
  // Config do APP WEB (PDV) — deploy estatico de apps/pdv/dist.
  // O painel admin usa o wrangler.jsonc da raiz (apps/pdv-admin/dist).
  // No projeto web do Cloudflare, defina o Deploy command:
  //   npx wrangler deploy -c wrangler.web.jsonc
  "name": "syscontrol-web-prod",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./apps/pdv/dist",
    "not_found_handling": "single-page-application"
  },
  // Ambiente de staging (dev online). Deploy com: --env staging
  // O build (build:staging) assa a URL do backend de dev; aqui só muda o nome.
  "env": {
    "staging": {
      "name": "syscontrol-web-staging",
      "assets": {
        "directory": "./apps/pdv/dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}

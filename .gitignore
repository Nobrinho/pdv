# NÃO ignorados (commitados de propósito, só têm VITE_API_URL público):
#   apps/pdv/.env.development, apps/pdv/.env.production
#   apps/pdv-admin/.env.development, apps/pdv-admin/.env.production
.env
.env.local
.env.*.local
.agent
.syscontrol
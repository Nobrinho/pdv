{
  // Deploy do painel admin como site estatico (Cloudflare Workers/Assets).
  // O build (vite) gera apps/pdv-admin/dist; aqui so publicamos os arquivos.
  "name": "pdv-admin",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./apps/pdv-admin/dist",
    "not_found_handling": "single-page-application"
  }
}

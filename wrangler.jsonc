{
  // Deploy do painel admin como site estatico (Cloudflare Workers/Assets).
  // O build (vite) gera apps/pdv-admin/dist; aqui so publicamos os arquivos.
  "name": "pdv-admin-prod",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./apps/pdv-admin/dist",
    "not_found_handling": "single-page-application"
  },
  // Ambiente de staging (dev online). Deploy com: --env staging
  // O build (admin:build:staging) assa a URL do backend de dev; aqui só muda o nome.
  "env": {
    "staging": {
      "name": "pdv-admin-staging",
      "assets": {
        "directory": "./apps/pdv-admin/dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
